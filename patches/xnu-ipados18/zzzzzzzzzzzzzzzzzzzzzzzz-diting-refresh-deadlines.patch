--- /dev/null
+++ b/iokit/Kernel/MiniDisplayRefreshClock.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#pragma once
+#include <stdint.h>
+
+/* A software refresh clock. These timestamps do not describe panel presents. */
+namespace DitingRefreshClock {
+struct Tick {
+    uint64_t reported = 0, next = 0, skipped = 0;
+    bool ready = false;
+};
+static inline uint64_t addPeriod(uint64_t time, uint64_t period)
+{
+    return UINT64_MAX - time < period ? UINT64_MAX : time + period;
+}
+static inline Tick select(uint64_t due, uint64_t now, uint64_t period)
+{
+    Tick tick;
+    if (!due || !period) return tick;
+    if (now < due) { tick.next = due; return tick; }
+    tick.skipped = (now - due) / period;
+    tick.reported = due + tick.skipped * period;
+    tick.next = addPeriod(tick.reported, period);
+    tick.ready = true;
+    return tick;
+}
+static inline uint64_t nextAfter(uint64_t last, uint64_t now, uint64_t period)
+{
+    if (!last) return addPeriod(now, period);
+    if (last > now) return last;
+    return select(last, now, period).next;
+}
+}
