+
+/* Called before current_thread is installed: index from the actual MPIDR,
+ * not cpu_number(), and use no locks or other CPU-local state. */
+void diting_secondary_kernel_step(uint64_t step);
+void diting_secondary_install_kernel_vectors(void);
+
+void
+diting_secondary_kernel_step(uint64_t step)
+{
+	uint64_t mpidr = __builtin_arm_rsr64("MPIDR_EL1");
+	unsigned cpu = (mpidr >> 8) & 7U;
+	os_atomic_store(&diting_secondary_reset[cpu].step, step, release);
+	CleanPoC_DcacheRegion((vm_offset_t)&diting_secondary_reset[cpu],
+	    sizeof(diting_secondary_reset[cpu]));
+}
+
+void
+diting_secondary_install_kernel_vectors(void)
+{
+	extern char ExceptionVectorsBase[];
+	/* arm_init_cpu installed its current thread and cpu_data first. */
+	__builtin_arm_wsr64("VBAR_EL1", (uint64_t)ExceptionVectorsBase);
+	__builtin_arm_isb(ISB_SY);
+}
 volatile uint32_t diting_cpu_start_progress = 0xff00;
 #define DITING_CPU_START_STEP(step) \
     (diting_cpu_start_progress = ((uint32_t)cpu << 8) | (step))
