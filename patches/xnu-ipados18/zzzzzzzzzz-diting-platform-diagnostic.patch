diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -1097,6 +1097,11 @@ IORamDiskBSDRoot(void)
 	return false;
 }
 
+#if defined(DITING)
+extern "C" uint64_t diting_platform_startup_diagnostic(void)
+    __attribute__((weak_import));
+#endif
+
 void
 IOSecureBSDRoot(const char * rootName)
 {
@@ -1109,6 +1114,17 @@ IOSecureBSDRoot(const char * rootName)
 	assert(matching);
 	pe = (IOPlatformExpert *) IOService::waitForMatchingService(matching, 30ULL * kSecondScale);
