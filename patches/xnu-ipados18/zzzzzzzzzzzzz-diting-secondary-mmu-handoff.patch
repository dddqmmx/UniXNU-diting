+#if defined(DITING)
+/* start.s restores cpu_ttep, not the static bootstrap TTBR1. These tables
+ * are allocated by arm_vm_init/pmap, outside the Mach-O static segments.
+ * Publish the existing tables to PoC before the cache-off core walks them.
+ * Only table descriptors are followed; block/leaf mappings are never data
+ * to clean here. Depth and entry count are bounded by the board's geometry. */
+_Static_assert(ARM_TT_ROOT_SHIFT == ARM_TT_L1_SHIFT, "Diting uses an L1 root");
+static unsigned
+diting_clean_start_tables(pmap_paddr_t physical, unsigned level)
+{
+	tt_entry_t *table = (tt_entry_t *)phystokv(physical);
+	unsigned pages = 1;
+	if (level < 3) {
+		for (unsigned i = 0; i < TTE_PGENTRIES; i++) {
+			tt_entry_t entry = os_atomic_load(&table[i], acquire);
+			if ((entry & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) ==
+			    (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+				pages += diting_clean_start_tables(entry & ARM_TTE_TABLE_MASK, level + 1);
+			}
+		}
+	}
+	CleanPoC_DcacheRegion((vm_offset_t)table, ARM_PGBYTES);
+	return pages;
+}
+#endif
