+/* namei may supply a full executable path for application launches. Match
+ * the final component, using the supplied bound, as the log route does. */
+static void
+exec_inject_basename(const char **name, size_t *length)
+{
+	size_t begin = 0;
+	for (size_t i = 0; i < *length; ++i) if ((*name)[i] == '/') begin = i + 1;
+	*name += begin;
+	*length -= begin;
+}
+
+/* A paired keyboard candidate can cover Spotlight before the prepared
+ * static init is refreshed. Only the existing UI/InputUI rule is extended. */
+static bool
+exec_keyboard_host_alias(const char *library, size_t liblen,
+    const char *word, size_t wordlen, const char *name, size_t namelen,
+    int enabled)
+{
+	return enabled == 1 &&
+	    liblen == sizeof("/diting/libditing-ui18.dylib") - 1 &&
+	    memcmp(library, "/diting/libditing-ui18.dylib", liblen) == 0 &&
+	    wordlen == sizeof("InputUI") - 1 && memcmp(word, "InputUI", wordlen) == 0 &&
+	    namelen == sizeof("Spotlight") - 1 && memcmp(name, "Spotlight", namelen) == 0;
+}
