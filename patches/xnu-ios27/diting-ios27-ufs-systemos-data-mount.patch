+#if DEVELOPMENT || DEBUG
+#include <libkern/crypto/sha2.h>
+extern "C" int native_diting_publish_boot_manifest(const char *os_uuid, const char *sys_uuid);
+extern "C" int
+native_diting_publish_boot_manifest(const char *os_uuid, const char *sys_uuid)
+{
+	if (!os_uuid || !sys_uuid) {
+		return 0;
+	}
+	IORegistryEntry *chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+	if (!chosen) {
+		return 0;
+	}
+	bool ok = true;
+	if (!chosen->getProperty("boot-manifest-hash")) {
+		static const char domain[] = "Diting.OwnerBootSet.v1";
+		uint8_t digest[48];
+		SHA384_CTX ctx;
+		SHA384_Init(&ctx);
+		SHA384_Update(&ctx, domain, sizeof(domain));
+		SHA384_Update(&ctx, os_uuid, strlen(os_uuid));
+		SHA384_Update(&ctx, sys_uuid, strlen(sys_uuid));
+		SHA384_Final(digest, &ctx);
+		OSData *value = OSData::withBytes(digest, sizeof(digest));
+		ok = value && chosen->setProperty("boot-manifest-hash", value);
+		OSSafeReleaseNULL(value);
+	}
+	/*
+	 * Publish a stable software IOPlatformUUID before launchd starts so
+	 * gethostuuid()/IOBSDGetPlatformUUID() never blocks configd/IPConfiguration
+	 * indefinitely when Apple unique-chip-id/chip-id are absent.
+	 */
+	IOPlatformExpert *platform = IOService::getPlatform();
+	IOService *provider = platform ? platform->getProvider() : nullptr;
+	if (provider && !provider->getProperty(kIOPlatformUUIDKey)) {
+		uuid_string_t uuid_str = {};
+		uuid_t parsed = {};
+		bool have_uuid = false;
+		if (OSData *dt_uuid = OSDynamicCast(OSData, chosen->getProperty("diting-platform-uuid"))) {
+			if (dt_uuid->getLength() == sizeof(uuid_string_t)) {
+				const char *raw = static_cast<const char *>(dt_uuid->getBytesNoCopy());
+				if (raw && raw[sizeof(uuid_string_t) - 1] == '\0' &&
+				    uuid_parse(raw, parsed) == 0 && !uuid_is_null(parsed)) {
+					uuid_unparse_upper(parsed, uuid_str);
+					have_uuid = true;
+				}
+			}
+		}
+		if (!have_uuid) {
+			static const char uuid_domain[] = "Diting.OwnerPlatformUUID.v1";
+			uint8_t udigest[48];
+			SHA384_CTX uctx;
+			SHA384_Init(&uctx);
+			SHA384_Update(&uctx, uuid_domain, sizeof(uuid_domain));
+			SHA384_Update(&uctx, os_uuid, strlen(os_uuid));
+			SHA384_Update(&uctx, sys_uuid, strlen(sys_uuid));
+			SHA384_Final(udigest, &uctx);
+			udigest[6] = (uint8_t)((udigest[6] & 0x0F) | 0x50);
+			udigest[8] = (uint8_t)((udigest[8] & 0x3F) | 0x80);
+			uuid_unparse_upper(udigest, uuid_str);
+			have_uuid = true;
+		}
+		if (have_uuid) {
+			OSString *uuid_obj = OSString::withCString(uuid_str);
+			if (uuid_obj) {
+				if (provider->setProperty(kIOPlatformUUIDKey, uuid_obj)) {
+					IOService::publishResource(kIOPlatformUUIDKey, uuid_obj);
+					printf("DITING_INIT: software IOPlatformUUID published=%s\n", uuid_str);
+				}
+				uuid_obj->release();
+			}
+		}
+	}
+	chosen->release();
+	return ok ? 1 : 0;
+}
