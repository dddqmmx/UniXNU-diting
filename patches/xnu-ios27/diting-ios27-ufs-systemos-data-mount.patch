+void
+diting_dump_process_snapshot(void)
+{
+	struct diting_ps_item { int pid; char name[24]; };
+	struct diting_ps_item *snap = kalloc_data(256 * sizeof(*snap), Z_WAITOK_ZERO);
+	if (!snap) {
+		return;
+	}
+	int count = 0;
+	int total_procs = 0;
+	int ui_pids[6] = {0};
+	char ui_names[6][24] = {{0}};
+	int ui_count = 0;
+	proc_t p;
+	proc_list_lock();
+	ALLPROC_FOREACH(p) {
+		total_procs++;
+		if (ui_count < 6 && (!strcmp(p->p_name, "backboardd") || !strcmp(p->p_name, "SpringBoard") ||
+		    !strcmp(p->p_name, "PosterBoard") || !strcmp(p->p_name, "com.apple.datamigrator") ||
+		    !strcmp(p->p_name, "runningboardd") || !strcmp(p->p_name, "WindowServer"))) {
+			ui_pids[ui_count] = proc_getpid(p);
+			strlcpy(ui_names[ui_count], p->p_name, sizeof(ui_names[ui_count]));
+			ui_count++;
+		}
+		if (count < 256) {
+			snap[count].pid = proc_getpid(p);
+			strlcpy(snap[count].name, p->p_name, sizeof(snap[count].name));
+			count++;
+		}
+	}
+	proc_list_unlock();
+	printf("DITING_PS: count=%d total=%d ui=%d\n", count, total_procs, ui_count);
+	for (int i = 0; i < count; i += 6) {
+		printf("DITING_PS:");
+		for (int j = i; j < count && j < i + 6; j++) {
+			printf(" %d:%s", snap[j].pid, snap[j].name);
+		}
+		printf("\n");
+	}
+	kfree_data(snap, 256 * sizeof(*snap));
+	if (diting_ufs_log_flush) {
+		diting_ufs_log_flush();
+	}
+	for (int pass = 0; pass < 2; pass++) {
+		for (int i = 0; i < ui_count; i++) {
+			if (pass == 1 && strcmp(ui_names[i], "backboardd") != 0 && strcmp(ui_names[i], "SpringBoard") != 0) {
+				continue;
+			}
+			proc_t up = proc_find(ui_pids[i]);
+			if (up != PROC_NULL) {
+				task_t ut = proc_task(up);
+				if (ut != TASK_NULL) {
+					diting_dump_task_threads(ui_names[i], ui_pids[i], ut, pass);
+				}
+				proc_rele(up);
+			}
+			if (diting_ufs_log_flush) {
+				diting_ufs_log_flush();
+			}
+		}
+	}
+}
