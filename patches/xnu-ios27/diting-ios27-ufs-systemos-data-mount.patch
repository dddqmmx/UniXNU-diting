+static int
+diting_ios27_mkdir_parents(proc_t p, user_addr_t scratch, const char *path)
+{
+	char current[160];
+	size_t len = strlen(path);
+	if (len >= sizeof(current)) {
+		return ENAMETOOLONG;
+	}
+	vfs_context_t ctx = vfs_context_current();
+	for (size_t i = 1; i < len; ++i) {
+		if (path[i] != '/') {
+			continue;
+		}
+		memcpy(current, path, i);
+		current[i] = 0;
+		vnode_t existing = NULLVP;
+		if (vnode_lookup(current, 0, &existing, ctx) == 0) {
+			if (existing) vnode_put(existing);
+			continue;
+		}
+		struct mkdir_args req = {.path = scratch + 0xd00, .mode = 0755};
+		int32_t res = 0;
+		int err = copyout(current, req.path, i + 1);
+		if (err) {
+			return err;
+		}
+		err = mkdir(p, &req, &res);
+		if (err && err != EEXIST) {
+			return err;
+		}
+	}
+	return 0;
+}
