+void
+diting_dump_task_threads(const char *name, int pid, task_t task, int with_bt)
+{
+	struct { uint32_t state; uint64_t pc, lr, fp, wev; } tinfo[24];
+	int n = 0;
+	vm_map_t map = VM_MAP_NULL;
+	task_lock(task);
+	if (with_bt) {
+		map = get_task_map(task);
+		if (map != VM_MAP_NULL) {
+			vm_map_reference(map);
+		}
+	}
+	thread_t th;
+	queue_iterate(&task->threads, th, thread_t, task_threads) {
+		if (n >= 24) {
+			break;
+		}
+		tinfo[n].state = th->state;
+		tinfo[n].wev = (uint64_t)th->wait_event;
+		tinfo[n].pc = tinfo[n].lr = tinfo[n].fp = 0;
+#if __arm64__
+		arm_saved_state_t *ss = find_user_regs(th);
+		if (ss != NULL) {
+			tinfo[n].pc = get_saved_state_pc(ss);
+			tinfo[n].lr = get_saved_state_lr(ss);
+			tinfo[n].fp = get_saved_state_fp(ss);
+		}
+#endif
+		n++;
+	}
+	task_unlock(task);
+	printf("DITING_TH: %s[%d] threads=%d pass=%d\n", name, pid, n, with_bt);
+	for (int i = 0; i < n; i++) {
+		if (!with_bt) {
+			printf("DITING_TH:   #%d st=0x%x pc=0x%llx lr=0x%llx fp=0x%llx wev=0x%llx\n",
+			    i, tinfo[i].state, tinfo[i].pc, tinfo[i].lr, tinfo[i].fp, tinfo[i].wev);
+		} else if (map != VM_MAP_NULL && tinfo[i].fp >= 0x100000000ULL &&
+		    tinfo[i].fp < 0x7000000000ULL && !(tinfo[i].fp & 7)) {
+			uint64_t fp = tinfo[i].fp;
+			printf("DITING_BT: %s#%d", name, i);
+			for (int f = 0; f < 10 && fp >= 0x100000000ULL && fp < 0x7000000000ULL && !(fp & 7); f++) {
+				uint64_t frame[2] = {0, 0};
+				if (vm_map_read_user(map, (vm_map_offset_t)fp, frame, sizeof(frame)) != KERN_SUCCESS) {
+					break;
+				}
+				printf(" %llx", frame[1] & 0x00007fffffffffffULL);
+				if (frame[0] <= fp) {
+					break;
+				}
+				fp = frame[0];
+			}
+			printf("\n");
+		}
+	}
+	if (map != VM_MAP_NULL) {
+		vm_map_deallocate(map);
+	}
+}
