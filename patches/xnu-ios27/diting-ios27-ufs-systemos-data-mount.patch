+static int
+diting_ios27_bind_mount(proc_t p, user_addr_t scratch, const char *source, const char *point, int flags)
+{
+	struct mount_args req = {
+		.type = scratch + 0xa00,
+		.path = scratch + 0xa20,
+		.flags = MNT_RDONLY | flags,
+		.data = scratch + 0xb00,
+	};
+	int32_t res = 0;
+	int err;
+	if ((err = copyout("bindfs", req.type, 7)) ||
+	    (err = copyout(point, req.path, strlen(point) + 1)) ||
+	    (err = copyout(source, req.data, strlen(source) + 1))) {
+		return err;
+	}
+	native_bindfs_boot_mount = 1;
+	err = mount(p, &req, &res);
+	native_bindfs_boot_mount = 0;
+	return err;
+}
