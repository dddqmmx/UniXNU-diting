diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -550,8 +550,11 @@
 static void
 arm64_implementation_specific_error(arm_saved_state_t *state, uint64_t esr, vm_offset_t far)
 {
-#pragma unused (state, esr, far)
-	panic_plain("Unhandled implementation specific error\n");
+	uint64_t pc = state ? get_saved_state_pc(state) : 0;
+	uint64_t pa = far ? (uint64_t)kvtophys(far) : 0;
+	panic_plain("Unhandled implementation specific error: cpu=%d esr=0x%llx far=0x%lx pa=0x%llx pc=0x%llx phys=[0x%llx+0x%llx]\n",
+	    cpu_number(), (unsigned long long)esr, (unsigned long)far, (unsigned long long)pa,
+	    (unsigned long long)pc, (unsigned long long)gPhysBase, (unsigned long long)gPhysSize);
 }
 
