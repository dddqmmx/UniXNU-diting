diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1425,6 +1425,36 @@ SYSCTL_PROC(_kern, OID_AUTO, initproc_spawned,
     CTLFLAG_RW | CTLFLAG_KERN | CTLTYPE_INT | CTLFLAG_LOCKED, 0, 0,
     sysctl_initproc_spawned, "I", "Boolean indicator that launchd has reached main");
 
+#if DEVELOPMENT || DEBUG
+static int
+diting_diagnostic_sysctl SYSCTL_HANDLER_ARGS
+{
+	char text[512];
+	proc_t process = current_proc();
+	if (!process) {
+		return EPERM;
+	}
+	if (!req->newptr || !req->newlen || req->newlen >= sizeof(text)) {
+		return EINVAL;
+	}
+	int error = SYSCTL_IN(req, text, req->newlen);
+	if (error) {
+		return error;
+	}
+	size_t n = req->newlen;
+	while (n > 0 && (text[n - 1] == '\n' || text[n - 1] == '\r')) {
+		n--;
+	}
+	text[n] = '\0';
+	printf("DITING_DIAG[%s:%d]: %s\n", process->p_name, proc_getpid(process), text);
+	return 0;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, diting_diagnostic,
+    CTLTYPE_STRING | CTLFLAG_WR | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    0, 0, diting_diagnostic_sysctl, "A", "Diting userspace GPU/renderer diagnostic record");
+#endif /* DEVELOPMENT || DEBUG */
+
 #if DEVELOPMENT || DEBUG
 
