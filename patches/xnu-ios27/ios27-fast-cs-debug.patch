+static int
+diting_fast_cs_enabled(void)
+{
+	static int cached = -1;
+	if (cached < 0) {
+		int v = 0;
+		cached = (PE_parse_boot_argn("diting_fast_cs", &v, sizeof(v)) && v == 1) ? 1 : 0;
+		if (cached) {
+			printf("DITING_CS: diting_fast_cs=1 skipping full 4K hash recomputation\n");
+		}
+	}
+	return cached;
+}
