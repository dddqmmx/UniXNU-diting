diff --git a/iokit/DriverKit/Makefile b/iokit/DriverKit/Makefile
index d456318..facf829 100644
--- a/iokit/DriverKit/Makefile
+++ b/iokit/DriverKit/Makefile
@@ -60,6 +60,7 @@ $(GENERATED_HEADERS) : \
 	%.h : %.iig
 	@$(LOG_IIG) "$@"
 	$(_v)$(IIG) --def $< --header $@ --impl $(patsubst %.h,%.iig.cpp,$@) --framework-name DriverKit ${OTHER_IIG_FLAGS} -- ${OTHER_IIG_CFLAGS} $(_vstdout)
+	$(_v)python3 -c 'import pathlib,sys; p=pathlib.Path(sys.argv[1]); s=p.read_text(); old="#define SimpleMemberFunctionCast(cfnty, self, func) ({ union { typeof(func) memfun; cfnty cfun; } pair; pair.memfun = func; pair.cfun; })"; new="#ifdef KERNEL\n#define SimpleMemberFunctionCast(cfnty, self, func) ((cfnty) OSMetaClassBase::_ptmf2ptf(&(self), (void (OSMetaClassBase::*)(void))(func)))\n#else\n" + old + "\n#endif"; assert old in s; p.write_text(s.replace(old, new, 1))' "$(patsubst %.h,%.iig.cpp,$@)"
 
 $(GENERATED_IMPL) : $(GENERATED_HEADERS)
 
