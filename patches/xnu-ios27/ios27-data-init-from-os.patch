+/*
+ * Trigger a clean DataMigration + SystemAppMigrator + LaunchServices rebuild when
+ * staged_system_apps is populated on a Data volume that had already booted once
+ * without it.
+ */
+static void
+diting_ios27_reset_system_app_migration(proc_t p, user_addr_t scratch, vfs_context_t ctx)
+{
+	int mig_rm = (diting_ios27_unlink_path(p, scratch,
+	    "/private/var/mobile/Library/Preferences/com.apple.migration.plist") == 0) ? 1 : 0;
+	int sentinel_rc = diting_ios27_write_file(p, scratch,
+	    "/private/var/datamigrator/migrate", "", 0, 0, 0644);
+	int mi_rm = 0, ls_rm = 0, sb_rm = 0;
+
+	static const char *const direct_mi[] = {
+	    "/private/var/mobile/Library/MobileInstallation/SystemAppState.plist",
+	    "/private/var/installd/Library/MobileInstallation/SystemAppState.plist",
+	    "/private/var/installd/Library/MobileInstallation/LastBuildInfo.plist",
+	    "/private/var/installd/Library/MobileInstallation/LastLaunchServicesMap.plist",
+	    "/private/var/installd/Library/MobileInstallation/PreInstallConsentSet.plist",
+	};
+	for (unsigned i = 0; i < sizeof(direct_mi) / sizeof(direct_mi[0]); ++i) {
+		if (diting_ios27_unlink_path(p, scratch, direct_mi[i]) == 0) {
+			mi_rm++;
+		}
+	}
+
+	static const char *const mi_leaves[] = {
+	    "SystemAppState.plist",
+	    "LastBuildInfo.plist",
+	    "LastLaunchServicesMap.plist",
+	    "PreInstallConsentSet.plist",
+	};
+	const unsigned max_uuids = 256;
+	const size_t uuid_stride = 64;
+	char *uuids = kalloc_data(max_uuids * uuid_stride, Z_WAITOK);
+	char *path = kalloc_data(MAXPATHLEN, Z_WAITOK);
+	if (uuids && path) {
+		unsigned sys_n = diting_ios27_list_subdirs("/private/var/containers/Data/System",
+		    uuids, max_uuids, uuid_stride, ctx);
+		for (unsigned i = 0; i < sys_n; ++i) {
+			const char *u = uuids + i * uuid_stride;
+			for (unsigned j = 0; j < sizeof(mi_leaves) / sizeof(mi_leaves[0]); ++j) {
+				snprintf(path, MAXPATHLEN,
+				    "/private/var/containers/Data/System/%s/Library/MobileInstallation/%s",
+				    u, mi_leaves[j]);
+				if (diting_ios27_unlink_path(p, scratch, path) == 0) {
+					mi_rm++;
+				}
+			}
+			snprintf(path, MAXPATHLEN,
+			    "/private/var/containers/Data/System/%s/Library/Caches", u);
+			ls_rm += diting_ios27_unlink_prefix_in_dir(p, scratch, path,
+			    "com.apple.LaunchServices-", ctx);
+		}
+		unsigned id_n = diting_ios27_list_subdirs("/private/var/mobile/Containers/Data/InternalDaemon",
+		    uuids, max_uuids, uuid_stride, ctx);
+		for (unsigned i = 0; i < id_n; ++i) {
+			snprintf(path, MAXPATHLEN,
+			    "/private/var/mobile/Containers/Data/InternalDaemon/%s/Library/Caches",
+			    uuids + i * uuid_stride);
+			ls_rm += diting_ios27_unlink_prefix_in_dir(p, scratch, path,
+			    "com.apple.LaunchServices-", ctx);
+		}
+	}
+	if (path) kfree_data(path, MAXPATHLEN);
+	if (uuids) kfree_data(uuids, max_uuids * uuid_stride);
+
+	ls_rm += diting_ios27_unlink_prefix_in_dir(p, scratch,
+	    "/private/var/mobile/Library/Caches", "com.apple.LaunchServices-", ctx);
+	(void)diting_ios27_unlink_path(p, scratch, "/private/var/ngpu/ls-store-rebuilt-1");
+
+	if (diting_ios27_unlink_path(p, scratch,
+	    "/private/var/mobile/Library/SpringBoard/IconState.plist") == 0) {
+		sb_rm++;
+	}
+	if (diting_ios27_unlink_path(p, scratch,
+	    "/private/var/mobile/Library/SpringBoard/DesiredIconState.plist") == 0) {
+		sb_rm++;
+	}
+
+	printf("DITING_INIT: staged_apps reset_migration sentinel=%d mig_plist_rm=%d mi_rm=%d ls_rm=%d sb_rm=%d\n",
+	    sentinel_rc, mig_rm, mi_rm, ls_rm, sb_rm);
+}
