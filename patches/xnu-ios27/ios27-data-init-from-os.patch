+static int
+diting_ios27_write_file(proc_t p, user_addr_t scratch, const char *path, const char *body,
+    uid_t uid, gid_t gid, mode_t mode)
+{
+	size_t path_len = strlen(path) + 1;
+	if (path_len > 0x3f0) {
+		return ENAMETOOLONG;
+	}
+	int err = diting_ios27_mkdir_parents(p, scratch, path);
+	if (err) {
+		return err;
+	}
+	int32_t res = 0;
+	int fd = -1;
+	err = copyout(path, scratch + 0xc00, path_len);
+	if (!err) {
+		struct open_args op = {.path = scratch + 0xc00, .flags = O_WRONLY | O_CREAT | O_TRUNC | O_NOFOLLOW, .mode = mode};
+		err = open(p, &op, &res);
+		if (!err) {
+			fd = res;
+		}
+	}
+	size_t len = strlen(body);
+	for (size_t sent = 0; !err && fd >= 0 && sent < len; ) {
+		size_t piece = (len - sent < 0x1f0) ? (len - sent) : 0x1f0;
+		err = copyout(body + sent, scratch + 0x200, piece);
+		if (!err) {
+			struct write_args wr = {.fd = fd, .cbuf = scratch + 0x200, .nbyte = piece};
+			user_ssize_t written = 0;
+			err = write(p, &wr, &written);
+			if (!err && written != (user_ssize_t)piece) {
+				err = EIO;
+			}
+		}
+		sent += piece;
+	}
+	if (fd >= 0) {
+		struct fchown_args ow = {.fd = fd, .uid = uid, .gid = gid};
+		struct fchmod_args cm = {.fd = fd, .mode = mode};
+		struct close_args cl = {.fd = fd};
+		(void)fchown(p, &ow, &res);
+		(void)fchmod(p, &cm, &res);
+		(void)sys_close(p, &cl, &res);
+	}
+	return err;
+}
+
+static int
+diting_ios27_unlink_path(proc_t p, user_addr_t scratch, const char *path)
+{
+	size_t path_len = strlen(path) + 1;
+	if (path_len > 0x3f0) {
+		return ENAMETOOLONG;
+	}
+	struct unlink_args req = {.path = scratch + 0xc00};
+	int32_t res = 0;
+	int err = copyout(path, req.path, path_len);
+	if (!err) {
+		err = unlink(p, &req, &res);
+	}
+	return err;
+}
+
+static int
+diting_ios27_unlink_prefix_in_dir(proc_t p, user_addr_t scratch, const char *dir_path, const char *prefix,
+    vfs_context_t ctx)
+{
+	vnode_t dir = NULLVP;
+	if (vnode_lookup(dir_path, VNODE_LOOKUP_NOFOLLOW, &dir, ctx) != 0 || !dir) {
+		return 0;
+	}
+	if (vnode_vtype(dir) != VDIR) {
+		vnode_put(dir);
+		return 0;
+	}
+	const uint32_t entries_size = 8192;
+	const unsigned max_names = 16;
+	const size_t name_stride = 128;
+	uint8_t *entries = kalloc_data(entries_size, Z_WAITOK);
+	char *names = kalloc_data(max_names * name_stride, Z_WAITOK);
+	char *full = kalloc_data(MAXPATHLEN, Z_WAITOK);
+	unsigned found = 0;
+	size_t pfx_len = strlen(prefix);
+	if (entries && names && full && VNOP_OPEN(dir, FREAD, ctx) == 0) {
+		off_t offset = 0;
+		for (int eof = 0; !eof && found < max_names; ) {
+			uio_t uio = uio_create(1, offset, UIO_SYSSPACE, UIO_READ);
+			if (!uio) {
+				break;
+			}
+			uio_addiov(uio, CAST_USER_ADDR_T(entries), entries_size);
+			int count = 0;
+			int rerr = vnode_readdir64(dir, uio, VNODE_READDIR_EXTENDED, &eof, &count, ctx);
+			uint32_t filled = entries_size - (uint32_t)uio_resid(uio);
+			offset = uio_offset(uio);
+			uio_free(uio);
+			if (rerr || !filled) {
+				break;
+			}
+			for (uint32_t at = 0; at + offsetof(struct direntry, d_name) < filled && found < max_names; ) {
+				struct direntry *de = (struct direntry *)(entries + at);
+				if (!de->d_reclen || at + de->d_reclen > filled) {
+					break;
+				}
+				at += de->d_reclen;
+				const char *name = de->d_name;
+				if (!de->d_ino || !strcmp(name, ".") || !strcmp(name, "..")) {
+					continue;
+				}
+				if (strncmp(name, prefix, pfx_len) == 0 && strlen(name) < name_stride) {
+					strlcpy(names + found * name_stride, name, name_stride);
+					found++;
+				}
+			}
+		}
+		VNOP_CLOSE(dir, FREAD, ctx);
+	}
+	vnode_put(dir);
+	int removed = 0;
+	if (names && full) {
+		for (unsigned i = 0; i < found; ++i) {
+			snprintf(full, MAXPATHLEN, "%s/%s", dir_path, names + i * name_stride);
+			if (diting_ios27_unlink_path(p, scratch, full) == 0) {
+				removed++;
+			}
+		}
+	}
+	if (full) kfree_data(full, MAXPATHLEN);
+	if (names) kfree_data(names, max_names * name_stride);
+	if (entries) kfree_data(entries, entries_size);
+	return removed;
+}
+
+static unsigned
+diting_ios27_list_subdirs(const char *dir_path, char *out_names, unsigned max_names, size_t stride,
+    vfs_context_t ctx)
+{
+	vnode_t dir = NULLVP;
+	if (vnode_lookup(dir_path, VNODE_LOOKUP_NOFOLLOW, &dir, ctx) != 0 || !dir) {
+		return 0;
+	}
+	if (vnode_vtype(dir) != VDIR) {
+		vnode_put(dir);
+		return 0;
+	}
+	const uint32_t entries_size = 8192;
+	uint8_t *entries = kalloc_data(entries_size, Z_WAITOK);
+	unsigned found = 0;
+	if (entries && VNOP_OPEN(dir, FREAD, ctx) == 0) {
+		off_t offset = 0;
+		for (int eof = 0; !eof && found < max_names; ) {
+			uio_t uio = uio_create(1, offset, UIO_SYSSPACE, UIO_READ);
+			if (!uio) {
+				break;
+			}
+			uio_addiov(uio, CAST_USER_ADDR_T(entries), entries_size);
+			int count = 0;
+			int rerr = vnode_readdir64(dir, uio, VNODE_READDIR_EXTENDED, &eof, &count, ctx);
+			uint32_t filled = entries_size - (uint32_t)uio_resid(uio);
+			offset = uio_offset(uio);
+			uio_free(uio);
+			if (rerr || !filled) {
+				break;
+			}
+			for (uint32_t at = 0; at + offsetof(struct direntry, d_name) < filled && found < max_names; ) {
+				struct direntry *de = (struct direntry *)(entries + at);
+				if (!de->d_reclen || at + de->d_reclen > filled) {
+					break;
+				}
+				at += de->d_reclen;
+				const char *name = de->d_name;
+				if (!de->d_ino || !strcmp(name, ".") || !strcmp(name, "..")) {
+					continue;
+				}
+				if (strlen(name) < stride) {
+					strlcpy(out_names + found * stride, name, stride);
+					found++;
+				}
+			}
+		}
+		VNOP_CLOSE(dir, FREAD, ctx);
+	}
+	vnode_put(dir);
+	if (entries) {
+		kfree_data(entries, entries_size);
+	}
+	return found;
+}
