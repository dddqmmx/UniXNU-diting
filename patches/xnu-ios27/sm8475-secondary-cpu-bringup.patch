diff --git a/osfmk/arm64/cpu.c b/osfmk/arm64/cpu.c
--- a/osfmk/arm64/cpu.c
+++ b/osfmk/arm64/cpu.c
@@ -902,6 +902,32 @@ ctrr_cpu_start_lck_init(void)
 }
 #endif
 
+#if !defined(XNU_FILESET_REFERENCE) || !XNU_FILESET_REFERENCE
+extern pmap_paddr_t cpu_ttep;
+#if HAS_NATIVE_PAC
+extern uint64_t native_pac_keys[];
+#endif
+extern void diting_ramoops_diagnostic_write(const char *str, int length);
+
+static unsigned
+diting_clean_start_tables(pmap_paddr_t physical, unsigned level)
+{
+	tt_entry_t *table = (tt_entry_t *)phystokv(physical);
+	unsigned pages = 1;
+	if (level < 3) {
+		for (unsigned i = 0; i < TTE_PGENTRIES; i++) {
+			tt_entry_t entry = os_atomic_load(&table[i], acquire);
+			if ((entry & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) ==
+			    (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+				pages += diting_clean_start_tables(entry & ARM_TTE_TABLE_MASK, level + 1);
+			}
+		}
+	}
+	CleanPoC_DcacheRegion((vm_offset_t)table, ARM_PGBYTES);
+	return pages;
+}
+#endif
+
 void
 cpu_start(int cpu)
 {
@@ -942,6 +966,24 @@ cpu_start(int cpu)
 
 		flush_dcache((vm_offset_t)&CpuDataEntries[cpu], sizeof(cpu_data_entry_t), FALSE);
 		flush_dcache((vm_offset_t)cpu_data_ptr, sizeof(cpu_data_t), FALSE);
+#if !defined(XNU_FILESET_REFERENCE) || !XNU_FILESET_REFERENCE
+		CleanPoC_DcacheRegion((vm_offset_t)&ResetHandlerData, sizeof(ResetHandlerData));
+		CleanPoC_DcacheRegion((vm_offset_t)&CpuDataEntries[0], sizeof(CpuDataEntries));
+		CleanPoC_DcacheRegion((vm_offset_t)cpu_data_ptr, sizeof(cpu_data_t));
+		CleanPoC_DcacheRegion((vm_offset_t)&cpu_ttep, sizeof(cpu_ttep));
+#if HAS_NATIVE_PAC
+		CleanPoC_DcacheRegion((vm_offset_t)native_pac_keys, 11 * sizeof(uint64_t));
+#endif
+		unsigned cleaned_pages = diting_clean_start_tables(cpu_ttep, 1);
+		__builtin_arm_dsb(DSB_SY);
+		{
+			char smsg[96];
+			int sn = snprintf(smsg, sizeof(smsg), "SCPU: start cpu=%d phys=0x%x pages=%u\n",
+			    cpu, cpu_data_ptr->cpu_phys_id, cleaned_pages);
+			if (sn > 0)
+				diting_ramoops_diagnostic_write(smsg, sn < (int)sizeof(smsg) ? sn : (int)sizeof(smsg) - 1);
+		}
+#endif
