+class KallocTypeIdentityTests(unittest.TestCase):
+    @staticmethod
+    def make_side(base, identities):
+        memory, fixups = {}, {}
+        for index, (name, summary, flags, size) in enumerate(identities):
+            address = base + index * 64
+            name_at, summary_at = base + 0x1000 + index * 0x200, base + 0x1100 + index * 0x200
+            record = bytearray(64)
+            struct.pack_into('<II', record, 0x28, flags, size)
+            memory[address] = bytes(record)
+            memory[name_at], memory[summary_at] = name.encode() + b'\0', summary + b'\0'
+            fixups[address + 0x10] = (name_at, 0, None, None, None)
+            fixups[address + 0x20] = (summary_at, 0, None, None, None)
+        def read(address, length):
+            for start, data in memory.items():
+                if start <= address and address + length <= start + len(data):
+                    return data[address-start:address-start+length]
+            raise ValueError('not backed')
+        image = SimpleNamespace(sections=[{'segment': '__DATA_CONST', 'name': '__kalloc_type',
+                                           'va': base, 'size': len(identities) * 64}],
+                                read=read, cstring=lambda address: memory.get(address, b'\0').split(b'\0')[0].decode())
+        return SimpleNamespace(image=image, fixups=fixups)
+
+    def test_same_complete_type_identity_names_the_native_view(self):
+        identity = ('site.lck_attr_t', b'', 0x6a, 4)
+        matcher = Matcher(self.make_side(0x1000, [identity]), self.make_side(0x8000, [identity]))
+        known = {}
+        self.assertEqual(matcher.anchor_kalloc_types(known), 1)
+        self.assertEqual(known, {0x1000: (0x8000, 'kalloc-type')})
+
+    def test_changed_size_pointer_summary_or_flags_cannot_supply_an_identity(self):
+        original = ('site.example', b'11122', 0x6a, 40)
+        for changed in (('site.example', b'11122', 0x6a, 48),
+                        ('site.example', b'11222', 0x6a, 40),
+                        ('site.example', b'11122', 0x7a, 40)):
+            matcher = Matcher(self.make_side(0x1000, [original]), self.make_side(0x8000, [changed]))
+            self.assertEqual(matcher.anchor_kalloc_types({}), 0)
+
+    def test_duplicate_allocation_sites_remain_ambiguous_after_one_is_known(self):
+        identity = ('site.example', b'12', 0x6a, 16)
+        for left, right in (([identity, identity], [identity]), ([identity], [identity, identity])):
+            matcher = Matcher(self.make_side(0x1000, left), self.make_side(0x8000, right))
+            known = {0x1040: (0x8040, 'reviewed')}
+            self.assertEqual(matcher.anchor_kalloc_types(known), 0)
+            self.assertNotIn(0x1000, known)
+
+    def test_missing_name_or_summary_fixup_cannot_anchor_a_view(self):
+        identity = ('site.example', b'12', 0x6a, 16)
+        for offset in (0x10, 0x20):
+            original = self.make_side(0x1000, [identity])
+            del original.fixups[0x1000 + offset]
+            matcher = Matcher(original, self.make_side(0x8000, [identity]))
+            self.assertEqual(matcher.anchor_kalloc_types({}), 0)
+
