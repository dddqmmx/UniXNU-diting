 #if SUPPORT_ARCH_arm64e
 void OutputFile::setFixup64e(uint8_t* fixUpLocation, uint64_t accumulator, Fixup::AuthData authData, const ld::Atom* toTarget)
 {
+	// An absent static weak provider is an absolute NULL, not an image-relative
+	// authenticated pointer.  buildChainedFixupInfo already excludes absolute
+	// symbols; keep this slot zero without truncating a rebase to the high image.
+	if ( targetNeedsNoFixup(toTarget) && (accumulator == 0) && (toTarget->combine() == ld::Atom::combineByName) ) {
+		set64LE(fixUpLocation, 0);
+		return;
+	}
+
 	uint32_t bindOrdinal = 0;
 	uint64_t inlineAddend = 0;
 	bool isBind = needsBind(toTarget, true, &accumulator, &inlineAddend, &bindOrdinal);
