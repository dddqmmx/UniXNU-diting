+ */
+static uint64_t tu_gmem_event_counts[2][4];
+
+extern "C" __attribute__((visibility("default"))) void tu_gmem_event_stats(uint64_t out[8]);
+extern "C" __attribute__((visibility("default"))) void
+tu_gmem_event_stats(uint64_t out[8])
+{
+   for (unsigned i = 0; i < 8; i++)
+      out[i] = p_atomic_read(&tu_gmem_event_counts[i / 4][i % 4]);
+}
 
