    tu_desc_set_swiz<CHIP>(desc, tu_swiz(X, Y, Z, W));
+
+   if (override_swap) {
+      const unsigned swap = CHIP >= A8XX ?
+         pkt_field_get(A8XX_TEX_MEMOBJ_3_SWAP, desc[3]) :
+         pkt_field_get(A6XX_TEX_MEMOBJ_0_SWAP, desc[0]);
+      const bool mutableen = CHIP >= A8XX ?
