  * side, [2] with MUTABLEEN, [3] of a linear image in memory. [1] is the counter that must stay zero for linear images.
  */
 static uint64_t tu_gmem_side_counts[4][4];
+
+/* Draw destinations retain the view's format contract. Rows: 2D system
+ * store, 3D system store, 3D GMEM load destination. Columns: transfers,
+ * non-identity format swap, mutable view, linear image. Pixel oracles, not
+ * an assumed zero swap count, qualify the actual transfer. */
+static uint64_t tu_gmem_destination_counts[3][4];
+extern "C" __attribute__((visibility("default"))) void tu_gmem_destination_stats(uint64_t out[12]);
+extern "C" __attribute__((visibility("default"))) void
+tu_gmem_destination_stats(uint64_t out[12])
+{
+   for (unsigned i = 0; i < 12; i++)
+      out[i] = p_atomic_read(&tu_gmem_destination_counts[i / 4][i % 4]);
+}
+
+static void
+tu_note_gmem_destination(unsigned site, const struct fdl6_view *view, unsigned swap)
+{
+   p_atomic_inc(&tu_gmem_destination_counts[site][0]);
+   if (swap != WZYX)
+      p_atomic_inc(&tu_gmem_destination_counts[site][1]);
+   if (view->is_mutable)
+      p_atomic_inc(&tu_gmem_destination_counts[site][2]);
+   if (pkt_field_get(A6XX_RB_RESOLVE_SYSTEM_BUFFER_INFO_TILE_MODE,
+                     view->RB_RESOLVE_SYSTEM_BUFFER_INFO) == TILE6_LINEAR)
+      p_atomic_inc(&tu_gmem_destination_counts[site][3]);
+}
 
